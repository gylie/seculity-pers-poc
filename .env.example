# Copy to .env and fill in. .env is gitignored and copied to the server with chmod 600.

# Wyze account
WYZE_EMAIL=
WYZE_PASSWORD=
# Wyze developer API credentials (https://developer-api-console.wyze.com)
API_ID=
API_KEY=
# Only if your Wyze 2FA uses an authenticator app: the base32 secret, not a 6-digit code.
# Leave blank for SMS/email 2FA and enter the code in the bridge web UI instead.
TOTP_KEY=

# Password for the bridge web UI (reached only through an SSH tunnel)
WB_PASSWORD=

# The one test camera, exactly as named in the Wyze app, e.g. Living Room Cam.
# The bridge streams ONLY this camera; every other camera on the account stays off.
CAMERA_FILTER=
# The same camera as the bridge exposes it (lowercase, dashes), e.g. living-room-cam
CAMERA_NAME=

# Meta Model API key for the caregiver layer (Muse Spark summaries and alert wording).
# Starts with LLM_. Leave empty to run with rule-based alerts only.
META_API_KEY=

# Deploy target for scripts/: SSH user and host of your VPS
MUSE_HOST=user@your-vps
